#!/usr/bin/env bash
# azusa-diff — 导出/对比系统状态，用来验证「两台机器是否真的等价」
#
#   azusa-diff dump > state.tsv        # 在机器 A 上导出
#   azusa-diff dump > state-b.tsv      # 在机器 B 上导出
#   azusa-diff compare state.tsv state-b.tsv
#
# 为什么需要它：azusa-verify 检查的是「我写了什么」，属于自证。
# 只有把两台机器的实际状态摊开做差分，才能发现「我漏了什么」。
set -uo pipefail

ACTION="${1:-dump}"

# 所有条目必须是三个字段：section <TAB> key <TAB> value
# 两字段会被 compare 当成空 key，同一 section 的所有条目会塌缩成一条。
emit() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }

dump_packages() {
    # 只比包名，不比版本（版本差异是噪音）
    dpkg-query -W -f='${Package}\n' 2>/dev/null | sort -u | while read -r p; do
        emit pkg "$p" installed
    done
}

dump_gsettings() {
    for schema in org.gnome.desktop.interface \
                  org.gnome.desktop.background \
                  org.gnome.desktop.wm.preferences \
                  org.gnome.Ptyxis; do
        gsettings list-recursively "$schema" 2>/dev/null \
            | while read -r _sc key rest; do
                emit gset "$_sc $key" "$rest"
              done
    done
    # ptyxis profile（uuid 每台机器不同，key 里不含 uuid）
    local uuid
    uuid=$(gsettings get org.gnome.Ptyxis default-profile-uuid 2>/dev/null | tr -d "'")
    [ -n "$uuid" ] && gsettings list-recursively \
        "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/" 2>/dev/null \
        | while read -r _sc key rest; do
            emit gset "ptyxis-profile $key" "$rest"
          done
}

dump_files() {
    for f in /etc/os-release /etc/lsb-release /etc/issue /etc/issue.net; do
        [ -f "$f" ] && emit file "$f" "$(sha256sum "$f" | cut -c1-16)"
    done
    # 只比对和 Azusa 有关的行，避免整文件被系统更新干扰
    [ -f /etc/default/grub ] && grep '^GRUB_COLOR' /etc/default/grub 2>/dev/null \
        | while IFS='=' read -r k v; do emit grubcolor "$k" "$v"; done
}

dump_paths() {
    for f in /usr/local/bin/azusa-*; do
        [ -e "$f" ] && emit bin "$(basename "$f")" present
    done
    for f in /usr/share/backgrounds/azusa/*; do
        [ -e "$f" ] && emit wallpaper-system "$(basename "$f")" present
    done
    for f in "$HOME/.local/share/backgrounds/azusa/"*; do
        [ -e "$f" ] && emit wallpaper-user "$(basename "$f")" present
    done
    local pal="$HOME/.local/share/org.gnome.Ptyxis/palettes/azusa.palette"
    [ -f "$pal" ] && emit file ptyxis-palette "$(sha256sum "$pal" | cut -c1-16)"
    local kitty="$HOME/.config/kitty/azusa.conf"
    [ -f "$kitty" ] && emit file kitty-config "$(sha256sum "$kitty" | cut -c1-16)"
}

dump_fonts() {
    for fam in "Inter" "JetBrains Mono" "Noto Sans CJK SC"; do
        local got
        got=$(fc-match -f '%{family}' "$fam" 2>/dev/null | head -1)
        emit font "$fam" "${got:-缺失}"
    done
}

dump_icons() {
    local svg=/usr/share/icons/Papirus-Dark/48x48/places/folder.svg
    if [ -f "$svg" ]; then
        emit icon folder-color "$(grep -oE '#7e57c2|#5294e2' "$svg" | head -1)"
    else
        emit icon folder-color "papirus 未安装"
    fi
}

do_dump() {
    dump_packages
    dump_gsettings
    dump_files
    dump_paths
    dump_fonts
    dump_icons
}

do_compare() {
    local a="$1" b="$2"
    python3 - "$a" "$b" <<'PY'
import sys
from pathlib import Path

def load(p):
    d = {}
    for line in Path(p).read_text(errors="replace").splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            d[(parts[0], parts[1] if len(parts) > 2 else "")] = parts[-1]
    return d

a, b = load(sys.argv[1]), load(sys.argv[2])
sections = {}
for key in sorted(set(a) | set(b)):
    va, vb = a.get(key), b.get(key)
    if va != vb:
        sections.setdefault(key[0], []).append((key[1], va, vb))

total = sum(len(v) for v in sections.values())
if not total:
    print("两台机器的状态完全一致。")
    sys.exit(0)

print(f"共 {total} 处差异：\n")
for sec, items in sections.items():
    print(f"[{sec}]  {len(items)} 处")
    for name, va, vb in items[:12]:
        short = lambda v: (v[:40] + "…") if v and len(v) > 40 else (v or "(缺失)")
        print(f"  {name}")
        print(f"    A: {short(va)}")
        print(f"    B: {short(vb)}")
    if len(items) > 12:
        print(f"  …还有 {len(items) - 12} 处")
    print()
PY
}

case "$ACTION" in
    dump)    do_dump ;;
    compare) do_compare "${2:?用法: azusa-diff compare A B}" "${3:?用法: azusa-diff compare A B}" ;;
    *) echo "用法: azusa-diff [dump|compare A B]" >&2; exit 2 ;;
esac
