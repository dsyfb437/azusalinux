#!/usr/bin/env python3
"""azusa-abstract — 用色板程序化生成抽象壁纸

为什么不直接用角色图：发布版不能用有版权的素材，而抽象壁纸
既干净又更适合当系统默认（不抢图标、不显得像别人的私人壁纸）。
Windows / macOS 的默认壁纸也都是抽象的。

用法：
    ./bin/azusa-abstract                  # 生成全部风格
    ./bin/azusa-abstract --style aurora --seed 7
"""
from __future__ import annotations

import argparse
import json
import math
import random
import sys
from pathlib import Path

from PIL import Image, ImageChops, ImageDraw, ImageFilter

def _find_root() -> Path:
    """仓库布局用 script/..，安装后用 /usr/local/share/azusalinux。"""
    import os
    candidates = []
    if os.environ.get("AZUSA_ROOT"):
        candidates.append(Path(os.environ["AZUSA_ROOT"]))
    candidates.append(Path(__file__).resolve().parent.parent)
    candidates.append(Path("/usr/local/share/azusalinux"))
    for c in candidates:
        if (c / "branding" / "palette.json").exists():
            return c
    return Path(__file__).resolve().parent.parent


ROOT = _find_root()
PALETTE = ROOT / "branding" / "palette.json"
OUT = ROOT / "dist" / "wallpapers"

# 直接按目标分辨率渲染。之前是 1280x720 画完再放大，山脊的硬边被
# 放大两次（一次代码内、一次被桌面缩放到 2880x1800），所以全是锯齿。
SIZE = (2880, 1800)


def hex_to_rgb(value: str) -> tuple[int, int, int]:
    v = value.lstrip("#")
    return tuple(int(v[i:i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]


def vertical_gradient(size: tuple[int, int], top: str, bottom: str) -> Image.Image:
    w, h = size
    strip = Image.new("RGB", (1, h))
    px = strip.load()
    a, b = hex_to_rgb(top), hex_to_rgb(bottom)
    for y in range(h):
        t = y / max(1, h - 1)
        px[0, y] = tuple(round(a[i] + (b[i] - a[i]) * t) for i in range(3))
    return strip.resize(size)


def add_blob(canvas: Image.Image, center: tuple[float, float], radius: float,
             color: str, alpha: int, softness: float = 0.7) -> Image.Image:
    w, h = canvas.size
    cx, cy = center[0] * w, center[1] * h
    r = radius * min(w, h)

    mask = Image.new("L", (w, h), 0)
    ImageDraw.Draw(mask).ellipse([cx - r, cy - r, cx + r, cy + r], fill=alpha)
    mask = mask.filter(ImageFilter.GaussianBlur(r * softness))

    layer = Image.new("RGBA", (w, h), hex_to_rgb(color) + (0,))
    layer.putalpha(mask)
    return Image.alpha_composite(canvas.convert("RGBA"), layer)


def add_grain(canvas: Image.Image, amount: int = 10) -> Image.Image:
    """轻微噪点，避免大面积渐变在大屏上出现色带。"""
    noise = Image.effect_noise(canvas.size, 18).convert("L").point(
        lambda v: int(abs(v - 128) * amount / 128))
    layer = Image.new("RGBA", canvas.size, (255, 255, 255, 0))
    layer.putalpha(noise)
    return Image.alpha_composite(canvas.convert("RGBA"), layer)


def add_vignette(canvas: Image.Image, strength: int = 70) -> Image.Image:
    w, h = canvas.size
    mask = Image.new("L", (w, h), 0)
    ImageDraw.Draw(mask).ellipse((-w * 0.2, -h * 0.3, w * 1.2, h * 1.3), fill=255)
    mask = mask.filter(ImageFilter.GaussianBlur(min(w, h) / 6))
    mask = Image.eval(mask, lambda v: strength - int(v * strength / 255))
    layer = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    layer.putalpha(mask)
    return Image.alpha_composite(canvas.convert("RGBA"), layer)


def add_glow(canvas: Image.Image, center: tuple[float, float], radius: float,
             color: str, strength: float = 1.0) -> Image.Image:
    """径向发光，用屏幕混合——颜色会变亮而不是被搅成灰。"""
    w, h = canvas.size
    cx, cy = center[0] * w, center[1] * h
    r = radius * min(w, h)
    mask = Image.new("L", (w, h), 0)
    ImageDraw.Draw(mask).ellipse([cx - r, cy - r, cx + r, cy + r], fill=255)
    mask = mask.filter(ImageFilter.GaussianBlur(r * 0.55))
    mask = mask.point(lambda v: int(v * strength))
    glow = Image.new("RGB", (w, h), hex_to_rgb(color))
    glow = Image.composite(glow, Image.new("RGB", (w, h), (0, 0, 0)), mask)
    return ImageChops.screen(canvas.convert("RGB"), glow).convert("RGBA")


def add_ring(canvas: Image.Image, center: tuple[float, float], radius: float,
             color: str, width: int = 3, alpha: int = 120) -> Image.Image:
    """一条细弧线，给构图一点结构感。"""
    w, h = canvas.size
    cx, cy = center[0] * w, center[1] * h
    r = radius * min(w, h)
    ring = Image.new("L", (w, h), 0)
    ImageDraw.Draw(ring).ellipse([cx - r, cy - r, cx + r, cy + r],
                                 outline=alpha, width=width)
    ring = ring.filter(ImageFilter.GaussianBlur(width * 1.6))
    layer = Image.new("RGBA", (w, h), hex_to_rgb(color) + (0,))
    layer.putalpha(ring)
    return Image.alpha_composite(canvas.convert("RGBA"), layer)


def style_aurora(p: dict, rng: random.Random) -> Image.Image:
    """深靛底 + 右上紫光 + 一道细环，最克制的一版。"""
    d = p["dark"]
    c = vertical_gradient(SIZE, "#0d0a1c", d["bg"])
    c = add_glow(c, (0.72, 0.28), 0.55, d["primary"], 0.95)
    c = add_glow(c, (0.30, 0.78), 0.45, d["accent"], 0.55)
    c = add_ring(c, (0.72, 0.28), 0.34, d["accent"], 2, 90)
    return c


def style_ridge(p: dict, rng: random.Random) -> Image.Image:
    """斜向光带，像 macOS 那种「有方向感」的渐变壁纸。"""
    d = p["dark"]
    w, h = SIZE
    c = vertical_gradient(SIZE, d["bg"], "#0a0816")

    band = Image.new("L", SIZE, 0)
    bd = ImageDraw.Draw(band)
    bd.polygon([(-w * 0.1, h * 1.1), (w * 0.45, -h * 0.1),
                (w * 0.78, -h * 0.1), (w * 0.22, h * 1.1)], fill=255)
    band = band.filter(ImageFilter.GaussianBlur(w / 9))
    band = band.point(lambda v: int(v * 0.42))
    layer = Image.new("RGB", SIZE, hex_to_rgb(d["primary"]))
    layer = Image.composite(layer, Image.new("RGB", SIZE, (0, 0, 0)), band)
    c = ImageChops.screen(c.convert("RGB"), layer).convert("RGBA")

    c = add_glow(c, (0.2, 0.25), 0.4, d["accent"], 0.5)
    c = add_glow(c, (0.9, 0.85), 0.35, d["pink"], 0.35)
    return c


def style_mesh(p: dict, rng: random.Random) -> Image.Image:
    """多团发光，位置由种子决定，可复现。比之前用屏幕混合，不会糊。"""
    d = p["dark"]
    c = vertical_gradient(SIZE, "#0b0818", d["surface"])
    for color, strength in ((d["primary"], 0.9), (d["accent"], 0.6),
                            (d["pink"], 0.4), (d["accent"], 0.5)):
        c = add_glow(c,
                     (rng.uniform(0.1, 0.9), rng.uniform(0.1, 0.9)),
                     rng.uniform(0.3, 0.5), color, strength)
    return c


def style_veil(p: dict, rng: random.Random) -> Image.Image:
    """亮色：银白底 + 斜向淡紫。"""
    l = p["light"]
    c = vertical_gradient(SIZE, "#ffffff", l["overlay"])
    w, h = SIZE
    band = Image.new("L", SIZE, 0)
    bd = ImageDraw.Draw(band)
    bd.polygon([(-w * 0.1, h * 1.15), (w * 0.5, -h * 0.15),
                (w * 1.05, -h * 0.15), (w * 0.45, h * 1.15)], fill=255)
    band = band.filter(ImageFilter.GaussianBlur(w / 18))
    band = band.point(lambda v: int(v * 0.5))
    layer = Image.new("RGBA", SIZE, hex_to_rgb(l["primary"]) + (0,))
    layer.putalpha(band)
    return Image.alpha_composite(c.convert("RGBA"), layer)



def style_dusk(p: dict, rng: random.Random) -> Image.Image:
    """黄昏山脊：天空渐变 + 地平线辉光 + 多层剪影 + 星点。

    纯渐变永远像「没做完」——好的发行版壁纸是有层次的：
    天空、光源、远近几层地形。这里用正弦叠加画山脊线，
    越靠前越暗，模拟大气透视。
    """
    d = p["dark"]
    w, h = SIZE

    # 天空：顶部深靛，地平线附近偏紫
    sky = vertical_gradient(SIZE, "#05030f", "#2a1f4a")
    sky = add_glow(sky, (0.66, 0.60), 1.0, "#7d5fa8", 0.7)
    sky = add_glow(sky, (0.66, 0.60), 0.35, "#c9a6e0", 0.55)

    # 星点：只在上半部分，越靠近地平线越淡
    stars = Image.new("RGBA", SIZE, (0, 0, 0, 0))
    sd = ImageDraw.Draw(stars)
    for _ in range(220):
        x = rng.uniform(0, w)
        y = rng.uniform(0, h * 0.55)
        if rng.random() < (1 - y / (h * 0.55)) ** 1.5:
            r = rng.choice((1, 1, 1, 2))
            a = rng.randint(40, 170)
            sd.ellipse([x, y, x + r, y + r], fill=(235, 230, 255, a))
    sky = Image.alpha_composite(sky.convert("RGBA"),
                                stars.filter(ImageFilter.GaussianBlur(0.6)))

    # 山脊：5 层，越远越亮越偏紫，越近越暗越偏黑
    layers = 5
    far = (0x3a, 0x2d, 0x5e)
    near = (0x0d, 0x0a, 0x1c)
    for i in range(layers):
        t = i / (layers - 1)
        color = tuple(round(far[k] + (near[k] - far[k]) * t) for k in range(3))
        base_y = h * (0.55 + i * 0.085)
        amp = h * (0.055 - i * 0.006)
        f1 = rng.uniform(0.8, 1.6) / w * 6
        f2 = rng.uniform(2.0, 3.4) / w * 6
        p1, p2 = rng.uniform(0, 6.28), rng.uniform(0, 6.28)

        pts = [(0, h)]
        for x in range(0, w + 4, 4):
            y = (base_y
                 + amp * math.sin(x * f1 + p1)
                 + amp * 0.45 * math.sin(x * f2 + p2))
            pts.append((x, y))
        pts.append((w, h))

        # 蒙版按 2 倍尺寸绘制再缩回，等于 4x 超采样，边缘不再有阶梯
        big = (w * 2, h * 2)
        mask = Image.new("L", big, 0)
        ImageDraw.Draw(mask).polygon([(x * 2, y * 2) for x, y in pts], fill=255)
        mask = mask.resize((w, h), Image.LANCZOS)
        layer = Image.new("RGBA", SIZE, color + (0,))
        layer.putalpha(mask)

        # 山脊线上一层薄雾，拉开空间
        rim = Image.new("L", big, 0)
        ImageDraw.Draw(rim).line([(x * 2, y * 2) for x, y in pts[1:-1]], fill=38, width=4)
        rim = rim.resize((w, h), Image.LANCZOS).filter(ImageFilter.GaussianBlur(3))
        haze = Image.new("RGBA", SIZE, (200, 185, 240, 0))
        haze.putalpha(rim)
        sky = Image.alpha_composite(sky, haze)
        sky = Image.alpha_composite(sky, layer)

    return sky


STYLES = {
    "aurora": style_aurora,
    "mesh": style_mesh,
    "ridge": style_ridge,
    "veil": style_veil,
    "dusk": style_dusk,
}


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="azusa-abstract", description="程序化生成抽象壁纸")
    ap.add_argument("--style", choices=tuple(STYLES) + ("all",), default="all")
    ap.add_argument("--seed", type=int, default=20261122)
    ap.add_argument("--out", default=str(OUT))
    ap.add_argument("--size", metavar="WxH", default="2880x1800",
                    help="输出分辨率，默认 2880x1800（也对齐 16:10）")
    args = ap.parse_args(argv)

    global SIZE
    try:
        w, h = (int(v) for v in args.size.lower().split("x"))
    except ValueError:
        sys.exit("azusa-abstract: --size 格式应为 2880x1800")
    SIZE = (w, h)

    palette = json.loads(PALETTE.read_text())
    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    chosen = STYLES if args.style == "all" else {args.style: STYLES[args.style]}

    for name, fn in chosen.items():
        canvas = fn(palette, random.Random(args.seed))
        canvas = add_vignette(canvas, 70 if name != "veil" else 40)
        canvas = add_grain(canvas.convert("RGB"), 10)
        result = canvas.convert("RGB")
        dest = out / f"abstract-{name}-{SIZE[0]}x{SIZE[1]}.jpg"
        result.save(dest, quality=94, optimize=True)
        print(f"  {dest.name}  ({dest.stat().st_size / 1024:.0f} KB)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
