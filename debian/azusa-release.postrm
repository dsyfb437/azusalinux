#!/bin/sh
set -eu
case "$1" in
    remove|abort-install)
        for path in /usr/lib/os-release /etc/lsb-release /etc/issue /etc/issue.net; do
            if [ "$(dpkg-divert --listpackage "$path")" = azusa-release ]; then
                dpkg-divert --package azusa-release --remove --rename \
                    --divert "$path.ubuntu" "$path"
            fi
        done
        if [ -f /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
            update-grub
        fi
        ;;
esac
#DEBHELPER#
