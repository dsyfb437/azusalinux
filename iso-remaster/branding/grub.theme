title-text: "AzusaLinux"
title-color: "#ECE8F6"
desktop-color: "#181430"
message-color: "#ECE8F6"
message-bg-color: "#181430"

+ boot_menu {
    left = 12%
    top = 30%
    width = 78%
    height = 48%
    item_color = "#C4B5DC"
    selected_item_color = "#FFFFFF"
    item_height = 28
    item_spacing = 6
    item_padding = 6
}

+ label {
    left = 12%
    top = 85%
    color = "#C4B5DC"
    text = "Use the arrow keys to select an entry and Enter to boot."
}
