#cloud-config
autoinstall:
  version: 1
  locale: zh_CN.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: azusalinux
    username: azusa
    password: "$6$xBTJnT.niJ4sS0y4$C.7GUJCAfTJavZ/q7znYG1yn7J/pb/zGPLDk/qVilqvQdpvm9PJ7sfhVMi.DIn1u7zQCI/fJT5xKUmoLoRLBt."
  ssh:
    install-server: false
  packages: []
  late-commands:
    - cp -r /cdrom/azusa-debs /target/root/azusa-debs
    - curtin in-target -- apt-get update
    - curtin in-target -- sh -ec 'apt-get install -y /root/azusa-debs/azusa-*.deb'
    - install -D -m 0644 /cdrom/nocloud/apt/azusalinux-archive-keyring.asc /target/etc/apt/keyrings/azusalinux-archive-keyring.asc
    - install -m 0644 /cdrom/nocloud/apt/azusalinux.sources /target/etc/apt/sources.list.d/azusalinux.sources
    - curtin in-target -- update-grub
    - curtin in-target -- rm -rf /root/azusa-debs
